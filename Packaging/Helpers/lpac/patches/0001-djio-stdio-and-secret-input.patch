+static int read_djio_download_request(char **activation_code, char **confirmation_code) {
+    _cleanup_free_ char *line = NULL;
+    _cleanup_cjson_ cJSON *root = NULL;
+    _cleanup_cjson_ cJSON *request = NULL;
+    cJSON *value = NULL;
+    size_t capacity = 0;
+
+    request = cJSON_CreateObject();
+    if (request == NULL || cJSON_AddStringToObject(request, "func", "download_request") == NULL ||
+        !json_print("djio", request)) {
+        return -1;
+    }
+
+    if (getline(&line, &capacity, stdin) < 0) {
+        return -1;
+    }
+    root = cJSON_Parse(line);
+    if (root == NULL || !cJSON_IsObject(root)) {
+        return -1;
+    }
+
+    value = cJSON_GetObjectItem(root, "activationCode");
+    if (!cJSON_IsString(value) || value->valuestring[0] == '\0') {
+        return -1;
+    }
+    *activation_code = strdup(value->valuestring);
+    if (*activation_code == NULL) {
+        return -1;
+    }
+
+    value = cJSON_GetObjectItem(root, "confirmationCode");
+    if (cJSON_IsString(value) && value->valuestring[0] != '\0') {
+        *confirmation_code = strdup(value->valuestring);
+        if (*confirmation_code == NULL) {
+            return -1;
+        }
+    }
+    return 0;
+}
